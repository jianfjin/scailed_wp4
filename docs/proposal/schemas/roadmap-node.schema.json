{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scailed.example/schemas/roadmap-node.schema.json",
  "title": "Pathfinder Roadmap Node",
  "type": "object",
  "required": ["node_id", "label", "dimension", "maturity_level", "stakeholder_types", "prerequisites", "source_wp", "source_doc_ref", "confidence"],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "dimension": {"type": "string", "enum": ["governance", "data", "compliance", "infrastructure", "capability"]},
    "maturity_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "stakeholder_types": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "source_wp": {"type": "string", "minLength": 1},
    "source_doc_ref": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
