# ═══════════════════════════════════════════════════════════
# Backend Dockerfile — Python 3.12 FastAPI (无状态)
# 多阶段构建: builder (依赖安装) → runtime (最小镜像)
# ═══════════════════════════════════════════════════════════

# ─── Stage 1: Builder ────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 系统依赖 (psycopg2 编译 / AGE 客户端库)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 先复制依赖文件 (利用 Docker 缓存层)
COPY requirements.txt pyproject.toml* ./

# 安装 Python 依赖到 /install 前缀
RUN pip install --prefix=/install -r requirements.txt

# ─── Stage 2: Runtime ────────────────────────────────────
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/install/bin:${PATH}" \
    PYTHONPATH="/install/lib/python3.12/site-packages:/app:${PYTHONPATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r pathfinder && useradd -r -g pathfinder -d /app pathfinder

# 从 builder 复制预编译依赖
COPY --from=builder /install /install

WORKDIR /app

# 应用代码 (最后一层, 变更频率最高)
COPY --chown=pathfinder:pathfinder . .

# 非 root 运行
USER pathfinder

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 入口: uvicorn (生产环境建议 gunicorn + uvicorn workers)
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "4", "--log-level", "info"]
