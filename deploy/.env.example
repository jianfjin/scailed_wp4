# ═══════════════════════════════════════════════════════════
# SCAILED Pathfinder — Environment Variables
# 复制为 .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Deployment ──────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
COMPOSE_PROJECT_NAME=scailed

# ─── Traefik / Cloudflare Tunnel Origin ─────────────────
# Published Cloudflare application route should target:
#   http://127.0.0.1:8647
# Change TRAEFIK_HTTP_BIND to 0.0.0.0 only for non-tunnel LAN testing.
TRAEFIK_HTTP_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=8647
# TRAEFIK_HTTPS_PORT=443         # 生产环境启用

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=pathfinder
POSTGRES_PASSWORD=changeme       # 生产环境必须更换
POSTGRES_DB=pathfinder

# ─── Backend ─────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production-min-32-chars
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ─── Upstream WP Services ───────────────────────────────
WP3_API_URL=                     # WP3 路线图数据源 (JSON endpoint)
WP8_API_URL=                     # WP8 法规约束数据源 (YAML endpoint)

# ─── Redis (可选, 生产环境加密码) ─────────────────────────
# REDIS_PASSWORD=

# ─── Frontend ────────────────────────────────────────────
VITE_API_BASE_URL=/api           # API 路径前缀 (Traefik 路由)
