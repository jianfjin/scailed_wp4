{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scailed.eu/contracts/wp4-questionnaire.v2.schema.json",
  "title": "pf.questionnaire.v2 — explicit capability evidence mapping",
  "description": "Each mapped capability question declares yes, no or unknown. Unselected positive items do not assert absence.",
  "type": "object",
  "required": [
    "stakeholder_type",
    "version",
    "title",
    "target_scenarios",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "stakeholder_type": {
      "$ref": "#/$defs/taxid",
      "description": "References an active pf.taxonomy.v1 stakeholder_type_id."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taxid"
      },
      "description": "Scenario IDs from the active taxonomy."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "label",
          "question_type",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "$ref": "#/$defs/qid"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "help_text": {
            "type": "string"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "single_choice",
              "multi_choice",
              "numeric",
              "text"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_value": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_value": {
            "type": [
              "integer",
              "null"
            ],
            "description": "numeric questions: scale 1..5 enforced referentially (integer maturity, RFQ 3.2)."
          },
          "maturity_dimension": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/taxid"
              }
            ],
            "description": "Taxonomy dimension_id when the question feeds a maturity dimension."
          },
          "state_field": {
            "type": "string",
            "enum": [
              "capabilities",
              "missing_capabilities",
              "regulatory_flags"
            ],
            "description": "A multi-choice answer directly supplies this state collection."
          },
          "visible_if": {
            "type": [
              "object",
              "null"
            ],
            "description": "Conditional visibility: same condition grammar as pf.rulebundle.v1 conditions.",
            "additionalProperties": true
          },
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "description": "Capability vocabulary ID judged by an explicit yes/no/unknown answer."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "capability_id"
              ]
            },
            "then": {
              "properties": {
                "question_type": {
                  "const": "single_choice"
                },
                "options": {
                  "const": [
                    "yes",
                    "no",
                    "unknown"
                  ]
                }
              },
              "required": [
                "options"
              ],
              "not": {
                "required": [
                  "state_field"
                ]
              }
            }
          }
        ]
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "for-review",
        "approved"
      ],
      "default": "for-review"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "qid": {
      "type": "string",
      "pattern": "^pf:wp4:question:[a-z0-9-]{1,64}$"
    },
    "taxid": {
      "type": "string",
      "pattern": "^pf:wp(2|4):[a-z-]+:[a-z0-9-]{1,64}$"
    }
  }
}
