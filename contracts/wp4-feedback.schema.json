{
  "type": "object",
  "required": [
    "period",
    "min_cohort_size",
    "recipient"
  ],
  "additionalProperties": false,
  "properties": {
    "period": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "min_cohort_size": {
      "type": "integer",
      "minimum": 5,
      "default": 5
    },
    "roadmap": {
      "type": "object",
      "required": [
        "node_stats"
      ],
      "additionalProperties": false,
      "properties": {
        "node_stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "visits",
              "cohort_size"
            ],
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "$ref": "#/$defs/rmid"
              },
              "visits": {
                "type": "integer",
                "minimum": 0
              },
              "as_current_position": {
                "type": "integer",
                "minimum": 0
              },
              "as_target": {
                "type": "integer",
                "minimum": 0
              },
              "blocked_by_prerequisite_count": {
                "type": "integer",
                "minimum": 0
              },
              "label_incompleteness_reports": {
                "type": "integer",
                "minimum": 0
              },
              "cohort_size": {
                "type": "integer",
                "minimum": 5
              }
            }
          }
        },
        "unsatisfiable_route_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rmid"
          }
        }
      },
      "description": "B5 to WP3"
    },
    "rules": {
      "type": "object",
      "required": [
        "rule_stats"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "cohort_size"
            ],
            "additionalProperties": false,
            "properties": {
              "rule_id": {
                "$ref": "#/$defs/ruleid"
              },
              "evaluations": {
                "type": "integer",
                "minimum": 0
              },
              "triggers": {
                "type": "integer",
                "minimum": 0
              },
              "block_events": {
                "type": "integer",
                "minimum": 0
              },
              "unverified_marker_count": {
                "type": "integer",
                "minimum": 0
              },
              "conflict_events": {
                "type": "integer",
                "minimum": 0
              },
              "cohort_size": {
                "type": "integer",
                "minimum": 5
              }
            }
          }
        },
        "never_fired_rule_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleid"
          }
        }
      },
      "description": "B6 to WP8"
    },
    "questionnaire": {
      "type": "object",
      "required": [
        "question_stats"
      ],
      "additionalProperties": false,
      "properties": {
        "question_stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_id",
              "cohort_size"
            ],
            "additionalProperties": false,
            "properties": {
              "question_id": {
                "$ref": "#/$defs/qid"
              },
              "answers": {
                "type": "integer",
                "minimum": 0
              },
              "abandonment_after": {
                "type": "integer",
                "minimum": 0
              },
              "ambiguity_flags": {
                "type": "integer",
                "minimum": 0
              },
              "skip_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cohort_size": {
                "type": "integer",
                "minimum": 5
              }
            }
          }
        }
      },
      "description": "B7 to WP2"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "recipient": {
      "type": "string",
      "enum": [
        "WP2",
        "WP3",
        "WP8"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scailed.eu/contracts/wp4-feedback.schema.json",
  "title": "pf.feedback.v1 payload - WP4 aggregated feedback to WP2/WP3/WP8 (B5-B7)",
  "description": "Aggregated feedback. Per-cell thresholds reduce disclosure risk but do not establish anonymity.",
  "$defs": {
    "rmid": {
      "type": "string",
      "pattern": "^pf:wp3:node:[a-z0-9-]{1,64}$"
    },
    "ruleid": {
      "type": "string",
      "pattern": "^pf:wp8:rule:[a-z0-9-]{1,64}$"
    },
    "qid": {
      "type": "string",
      "pattern": "^pf:wp4:question:[a-z0-9-]{1,64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recipient": {
            "const": "WP3"
          }
        }
      },
      "then": {
        "required": [
          "roadmap"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rules"
              ]
            },
            {
              "required": [
                "questionnaire"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipient": {
            "const": "WP8"
          }
        }
      },
      "then": {
        "required": [
          "rules"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "roadmap"
              ]
            },
            {
              "required": [
                "questionnaire"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipient": {
            "const": "WP2"
          }
        }
      },
      "then": {
        "required": [
          "questionnaire"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "roadmap"
              ]
            },
            {
              "required": [
                "rules"
              ]
            }
          ]
        }
      }
    }
  ]
}
